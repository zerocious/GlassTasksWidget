# Только для разработки. Обычным пользователям .env не нужен: ключи вводятся в самом виджете
# (мастер «Подключение Google», или файл client_secret.json), там они хранятся зашифрованными.
#
# Google Cloud OAuth 2.0: клиент типа «Desktop app» (Приложение для ПК).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Необязательно: закрепить порт для входа.
# Если не задан, при каждом входе берётся свободный порт 127.0.0.1: Desktop-клиенту
# регистрировать redirect URI не нужно.
# Закрепление нужно только для клиента типа «Web application»: у него redirect URI должен
# совпасть точно, то есть http://127.0.0.1:<порт>/oauth2callback в Authorized redirect URIs
# (без слэша в конце). Занятый или зарезервированный Windows порт виджет заменит свободным,
# но Web-клиент после этого вернёт redirect_uri_mismatch.
# OAUTH_REDIRECT_PORT=<порт 1024-65535>
