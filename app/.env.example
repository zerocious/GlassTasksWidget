# Google Cloud OAuth 2.0 Desktop client
# Создайте OAuth Client ID (тип: Desktop) в Google Cloud Console
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Необязательно: порт локального redirect (по умолчанию 42813)
# OAUTH_REDIRECT_PORT=42813
#
# Приложение слушает redirect:
#   http://127.0.0.1:42813/oauth2callback
# Для Desktop-клиента обычно ничего добавлять не нужно.
# Если клиент типа Web application — добавьте этот URI в Authorized redirect URIs
# (точное совпадение, без слэша в конце пути).
