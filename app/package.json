{
  "name": "glass-tasks-widget",
  "version": "1.0.0",
  "description": "Glass Tasks ↔ Habits desktop widget powered by Google Tasks",
  "main": "electron/main.js",
  "author": "Glass Tasks",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.glasstasks.widget",
    "productName": "Glass Tasks Widget",
    "copyright": "Copyright © Glass Tasks",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "electron/**/*",
      "lib/**/*",
      "src/**/*",
      "build/icon.png",
      "config.json",
      "config.example.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env.example",
        "to": ".env.example"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Glass Tasks Widget",
      "uninstallDisplayName": "Glass Tasks Widget"
    }
  }
}
