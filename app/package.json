{
  "name": "glass-tasks-widget",
  "version": "1.1.0",
  "description": "Glass Tasks ↔ Habits desktop widget powered by Google Tasks",
  "main": "electron/main.js",
  "author": "Glass Tasks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zerocious/GlassTasksWidget.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "shortcut": "electron ./scripts/write-shortcuts.js",
    "prebuild:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prebuild-clean.ps1",
    "pack": "npm run prebuild:clean && electron-builder --dir && npm run shortcut",
    "pack:desktop": "npm run pack",
    "dist": "npm run prebuild:clean && electron-builder --win nsis && npm run shortcut",
    "build:win": "npm run dist",
    "dist:portable": "npm run prebuild:clean && electron-builder --win portable && npm run shortcut",
    "smoke:packaged": "node scripts/smoke-packaged.js"
  },
  "dependencies": {
    "@googleapis/tasks": "^17.0.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  },
  "build": {
    "appId": "com.glasstasks.widget",
    "productName": "Glass Tasks Widget",
    "copyright": "Copyright © Glass Tasks",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "electron/**/*",
      "lib/**/*",
      "src/**/*",
      "build/icon.png",
      "config.json",
      "config.example.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env.example",
        "to": ".env.example"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "zerocious",
        "repo": "GlassTasksWidget-releases"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Glass-Tasks-Widget-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Glass Tasks Widget",
      "uninstallDisplayName": "Glass Tasks Widget",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "afterPack": "scripts/after-pack.js"
  }
}
